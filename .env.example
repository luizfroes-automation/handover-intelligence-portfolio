# Provider: Google Gemini (official google-genai SDK)
# Why: generous free tier, no intermediary (direct Google API), native tool use / structured output support — satisfies ADR-001
GEMINI_API_KEY=your_key_here

# Model to use. Chosen on 6 November 2026 — provider models get retired, so
# recheck it if calls start failing. The code default is the same value.
GEMINI_MODEL=gemini-3.1-flash-lite
